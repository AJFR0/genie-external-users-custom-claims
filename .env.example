# Copy to .env (gitignored). Used by the local app and the CLIs.
DATABRICKS_HOST=https://<your-workspace-host>
WAREHOUSE_ID=<sql-warehouse-id>
ADMIN_PROFILE=<databricks-cli-profile-for-the-operator>
CATALOG=genie_claims_ref
NORTHWIND_CLIENT_ID=<northwind portal SP application id>
NORTHWIND_CLIENT_SECRET=<northwind portal SP OAuth secret>
NORTHWIND_GENIE_SPACE_ID=
LARKSPUR_CLIENT_ID=<larkspur portal SP application id>
LARKSPUR_CLIENT_SECRET=<larkspur portal SP OAuth secret>
LARKSPUR_GENIE_SPACE_ID=
APP_SESSION_SECRET=<any long random string>
APP_REDACT_IDS=false
# Bundle variables (picked up by `databricks bundle` when exported)
BUNDLE_VAR_warehouse_id=<sql-warehouse-id>
